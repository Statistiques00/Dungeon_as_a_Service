  "components": {
    "schemas": {
      "AttackResult": {
        "properties": {
          "degats_infliges": {
            "type": "integer",
            "title": "Degats Infliges"
          },
          "critique": {
            "type": "boolean",
            "title": "Critique"
          },
          "degats_subis": {
            "type": "integer",
            "title": "Degats Subis"
          },
          "pv_heros": {
            "type": "integer",
            "title": "Pv Heros"
          },
          "pv_monstre": {
            "type": "integer",
            "title": "Pv Monstre"
          },
          "issue": {
            "$ref": "#/components/schemas/Issue"
          },
          "or_gagne": {
            "type": "integer",
            "title": "Or Gagne"
          },
          "victoire": {
            "type": "boolean",
            "title": "Victoire"
          },
          "recit": {
            "type": "string",
            "title": "Recit"
          }
        },
        "type": "object",
        "required": [
          "degats_infliges",
          "critique",
          "degats_subis",
          "pv_heros",
          "pv_monstre",
          "issue",
          "or_gagne",
          "victoire",
          "recit"
        ],
        "title": "AttackResult"
      },
      "Body_login_auth_login_post": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^password$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Body_login_auth_login_post"
      },
      "CarteRead": {
        "properties": {
          "depart": {
            "type": "string",
            "title": "Depart"
          },
          "position": {
            "type": "string",
            "title": "Position"
          },
          "salles": {
            "items": {
              "$ref": "#/components/schemas/SalleCarte"
            },
            "type": "array",
            "title": "Salles"
          },
          "explorees": {
            "type": "integer",
            "title": "Explorees"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "depart",
          "position",
          "salles",
          "explorees",
          "total"
        ],
        "title": "CarteRead"
      },
      "Classe": {
        "type": "string",
        "enum": [
          "guerrier",
          "mage",
          "voleur"
        ],
        "title": "Classe"
      },
      "Direction": {
        "type": "string",
        "enum": [
          "nord",
          "sud",
          "est",
          "ouest"
        ],
        "title": "Direction"
      },
      "EntreeClassement": {
        "properties": {
          "rang": {
            "type": "integer",
            "title": "Rang"
          },
          "nom": {
            "type": "string",
            "title": "Nom"
          },
          "classe": {
            "$ref": "#/components/schemas/Classe"
          },
          "joueur": {
            "type": "string",
            "title": "Joueur"
          },
          "or": {
            "type": "integer",
            "title": "Or"
          },
          "victoire": {
            "type": "boolean",
            "title": "Victoire"
          },
          "est_vivant": {
            "type": "boolean",
            "title": "Est Vivant"
          }
        },
        "type": "object",
        "required": [
          "rang",
          "nom",
          "classe",
          "joueur",
          "or",
          "victoire",
          "est_vivant"
