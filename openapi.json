{
  "openapi": "3.1.0",
  "info": {
    "title": "Dungeon as a Service",
    "description": "\nMoteur de jeu de **Dungeon as a Service**, le rpg rétro du studio *Pixel Crypt*.\n\n1. créez un compte (`/auth/register`) puis cliquez sur **Authorize** ;\n2. créez un héros, explorez le donjon salle par salle ;\n3. survivez jusqu'à la salle du trône et terrassez la Liche.\n\nToutes les erreurs métier suivent le format `{\"detail\": {\"error\": \"CODE\", \"message\": \"...\"}}`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Système"
        ],
        "summary": "État du serveur",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthRead"
                }
              }
            }
          }
        }
      }
    },
    "/leaderboard": {
      "get": {
        "tags": [
          "Classement"
        ],
        "summary": "Top 10 des héros",
        "description": "Route publique : les vainqueurs de la Liche d'abord, puis par or amassé.",
        "operationId": "leaderboard_leaderboard_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EntreeClassement"
                  },
                  "type": "array",
                  "title": "Response Leaderboard Leaderboard Get"
                }
              }
            }
          }
        }
      }
    },
